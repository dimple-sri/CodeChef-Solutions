import java.util.ArrayList;
import java.util.Collections;
import java.util.Scanner;
class Codechef {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        // Step 1: Take input for number of languages
        int a  = sc.nextInt();
        sc.nextLine();
        // Step 2: Create ArrayList to store language names
        ArrayList<String> lang = new ArrayList<String>();
        // Step 3: Read n languages from user
        for(int i = 0; i < a; i++)
        {
            lang.add(sc.nextLine());
        }
        Collections.sort(lang);
        // Step 4: Sort the list
        if(!lang.isEmpty())
        {
            System.out.println("First Langugage:"+lang.get(0));
            System.out.println("Last Langugage:"+lang.get(lang.size()-1));
        }
        sc.close();
    }
}
